# Environment variables declared in this file are automatically made available to Prisma.
# See the documentation for more detail: https://pris.ly/d/prisma-schema#accessing-environment-variables-from-the-schema

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

DATABASE_URL="postgresql://johndoe:randompassword@localhost:5432/mydb?schema=public"

# Stripe
STRIPE_SECRET_KEY="REPLACE_ME"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="REPLACE_ME"
STRIPE_WEBHOOK_SECRET="REPLACE_ME"

# App URL (used for canonical metadata, sitemap/robots host output, and OAuth redirect URIs)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Google OAuth — https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID="REPLACE_ME"
GOOGLE_CLIENT_SECRET="REPLACE_ME"
GOOGLE_REDIRECT_URI="https://healsend.com/wp-login.php?loginSocial=google"
GOOGLE_OAUTH_ENABLED=false

# Apple OAuth — https://developer.apple.com/account/resources/identifiers
APPLE_CLIENT_ID="REPLACE_ME"
APPLE_TEAM_ID="REPLACE_ME"
APPLE_KEY_ID="REPLACE_ME"
APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_ME\n-----END PRIVATE KEY-----"
APPLE_REDIRECT_URI="https://healsend.com/wp-login.php?loginSocial=apple"
APPLE_OAUTH_ENABLED=false

# MD Integrations (telemedicine / doctor chat)
MD_API_BASE_URL="https://api.mdintegrations.com"
MD_WEBHOOK_URL="REPLACE_ME"
MD_WEBHOOK_SECRET="REPLACE_ME"
MD_CLIENT_ID="REPLACE_ME"
MD_CLIENT_SECRET="REPLACE_ME"

# OLA Portal (telehealth provider — alternative to MDI)
OLA_API_BASE_URL="https://dev-api.ola-digital-int.com"
OLA_AUTH_TOKEN="REPLACE_ME"
OLA_SECRET_TOKEN="REPLACE_ME"
OLA_SERVICE_KEY="REPLACE_ME"
OLA_SESSION_TYPE="Initial"

# Stop: docker stop healsend-postgres
# Remove: docker rm healsend-postgres

# admin: admin@healsend.com password: Admin123!
MD_LOCAL_DEV_FALLBACK=true

# Deployment audit targets
CUTOVER_ENV_AUDIT_TARGET="production"
MDI_ENV_AUDIT_TARGET="production"

# GoHighLevel CRM
GHL_API_KEY="REPLACE_ME_WITH_YOUR_GHL_API_KEY"
GHL_SYNC_ENABLED=false

# GoHighLevel OAuth (for multi-tenant SaaS — optional)
GHL_CLIENT_ID="REPLACE_ME"
GHL_CLIENT_SECRET="REPLACE_ME"
GHL_OAUTH_ENABLED=false

# WordPress import (used by scripts/import-wordpress-content.mjs)
WORDPRESS_SSH_HOST="173.237.189.106"
WORDPRESS_SSH_PORT="6543"
WORDPRESS_SSH_USER="root"
WORDPRESS_DB_CONTAINER="wp-mysql-prod"
WORDPRESS_DB_NAME="wordpress"
WORDPRESS_DB_USER="REPLACE_ME"
WORDPRESS_DB_PASSWORD="REPLACE_ME"
WORDPRESS_SITE_URL="https://healsend.com"
WORDPRESS_ASSET_BASE_URL="https://healsend.com/wp-content/uploads"
